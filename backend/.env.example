# ==========================================
# SkyCast Weather Engine - Environment Config
# ==========================================

# Gemini API Keys (Get yours from Google AI Studio: https://aistudio.google.com/)
gemini_api_key=your_gemini_api_key_here
gemini_api_key_fallback=your_gemini_fallback_key_here

# LLM Provider and Model Configuration
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-latest

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/skycast_weather

# Redis Cache URL (Optional: defaults to in-memory fallback if Redis is unavailable)
REDIS_URL=redis://127.0.0.1:6379/0

# Optional External Weather API Keys (For multi-source radar/alerts)
GOOGLE_WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Cache Time-To-Live (in seconds)
TTL_CURRENT_WEATHER=300
TTL_MAP_WEATHER=300
TTL_FORECAST=900
TTL_RADAR_META=180
TTL_ALERTS=600

# Background Worker Polling Interval (in seconds)
COLLECTOR_POLL_INTERVAL=180
